{
  "name": "guildhall-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:smoke": "pnpm --filter @guildhall/web build && pnpm --filter @guildhall/demo-agent build",
    "check": "pnpm check:workspace && pnpm test",
    "check:workspace": "pnpm -r --if-present typecheck && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:contracts": "vitest run tests/protocol/contracts.test.ts tests/protocol/schema-examples.test.ts",
    "test:crypto": "vitest run tests/protocol/crypto.test.ts",
    "test:state-machine": "vitest run tests/state-machine --exclude tests/state-machine/properties.test.ts",
    "test:state-properties": "vitest run tests/state-machine/properties.test.ts",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260826.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.126.0"
  }
}
