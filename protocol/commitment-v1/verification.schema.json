{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {
      "$ref": "#/$defs/__schema0"
    },
    "kind": {
      "$ref": "#/$defs/__schema1"
    },
    "verificationRunId": {
      "$ref": "#/$defs/__schema2"
    },
    "missionId": {
      "$ref": "#/$defs/__schema2"
    },
    "pactDigest": {
      "$ref": "#/$defs/__schema3"
    },
    "attempt": {
      "$ref": "#/$defs/__schema4"
    },
    "status": {
      "$ref": "#/$defs/__schema5"
    },
    "verifier": {
      "$ref": "#/$defs/__schema6"
    },
    "infrastructureStatus": {
      "$ref": "#/$defs/__schema7"
    },
    "criteria": {
      "$ref": "#/$defs/__schema8"
    },
    "correctionConsumed": {
      "$ref": "#/$defs/__schema10"
    },
    "startedAt": {
      "$ref": "#/$defs/__schema11"
    },
    "completedAt": {
      "$ref": "#/$defs/__schema12"
    }
  },
  "required": [
    "protocol",
    "kind",
    "verificationRunId",
    "missionId",
    "pactDigest",
    "attempt",
    "status",
    "verifier",
    "infrastructureStatus",
    "criteria",
    "correctionConsumed",
    "startedAt",
    "completedAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "commitment/v1"
    },
    "__schema1": {
      "type": "string",
      "const": "verification"
    },
    "__schema2": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "__schema3": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "__schema4": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "__schema5": {
      "type": "string",
      "enum": ["passed", "failed", "infrastructure-pending", "safety-rejected"]
    },
    "__schema6": {
      "type": "object",
      "properties": {
        "verifierId": {
          "type": "string",
          "const": "accessibility-dungeon-v1"
        },
        "version": {
          "type": "string",
          "pattern": "^1\\.[0-9]+\\.[0-9]+$"
        }
      },
      "required": ["verifierId", "version"],
      "additionalProperties": false
    },
    "__schema7": {
      "type": "string",
      "enum": ["available", "unavailable"]
    },
    "__schema8": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema9"
      }
    },
    "__schema9": {
      "type": "object",
      "properties": {
        "criterionId": {
          "$ref": "#/$defs/__schema2"
        },
        "status": {
          "type": "string",
          "enum": ["passed", "failed"]
        },
        "artifactIds": {
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema2"
          }
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": ["criterionId", "status", "artifactIds", "evidence"],
      "additionalProperties": false
    },
    "__schema10": {
      "type": "boolean"
    },
    "__schema11": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "__schema12": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema11"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$id": "https://guildhall.dev/protocol/commitment-v1/verification.schema.json"
}
