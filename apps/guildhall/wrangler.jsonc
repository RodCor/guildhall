{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "guildhall",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
  },
}
