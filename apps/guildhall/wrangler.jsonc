{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "guildhall",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true,
  },
  "secrets": {
    "required": [
      "GITHUB_CLIENT_SECRET",
      "AUTH_COOKIE_SECRET",
      "GUILD_ISSUER_KEY_ID",
      "GUILD_ISSUER_PRIVATE_JWK",
    ],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MISSIONS",
        "class_name": "MissionCoordinator",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MissionCoordinator"],
    },
  ],
  "d1_databases": [
    {
      "binding": "GUILD_DB",
      "database_name": "guildhall",
      "database_id": "858fc7fa-ca50-4062-a1c8-b20989281a81",
      "migrations_dir": "../../migrations/d1",
    },
  ],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/a2a/*", "/.well-known/*", "/fixtures/*"],
  },
}
