{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {
      "type": "string",
      "const": "commitment/v1"
    },
    "kind": {
      "type": "string",
      "const": "artifact-metadata"
    },
    "artifactId": {
      "$ref": "#/$defs/__schema0"
    },
    "missionId": {
      "$ref": "#/$defs/__schema0"
    },
    "pactDigest": {
      "$ref": "#/$defs/__schema1"
    },
    "roleSlotId": {
      "$ref": "#/$defs/__schema0"
    },
    "producingAgentId": {
      "$ref": "#/$defs/__schema0"
    },
    "keyId": {
      "$ref": "#/$defs/__schema0"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "artifactType": {
      "type": "string",
      "enum": [
        "accessibility-findings",
        "remediation-plan",
        "verification-evidence"
      ]
    },
    "mediaType": {
      "type": "string",
      "const": "application/json"
    },
    "publicLocation": {
      "type": "string",
      "format": "uri"
    },
    "contentDigest": {
      "$ref": "#/$defs/__schema1"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    },
    "safetyStatus": {
      "type": "string",
      "const": "approved"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    }
  },
  "required": [
    "protocol",
    "kind",
    "artifactId",
    "missionId",
    "pactDigest",
    "roleSlotId",
    "producingAgentId",
    "keyId",
    "attempt",
    "artifactType",
    "mediaType",
    "publicLocation",
    "contentDigest",
    "signature",
    "safetyStatus",
    "completedAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    }
  },
  "$id": "https://guildhall.dev/protocol/commitment-v1/artifact-metadata.schema.json"
}
