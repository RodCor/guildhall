{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {
      "$ref": "#/$defs/__schema0"
    },
    "kind": {
      "$ref": "#/$defs/__schema1"
    },
    "pactId": {
      "$ref": "#/$defs/__schema2"
    },
    "missionId": {
      "$ref": "#/$defs/__schema2"
    },
    "missionVersion": {
      "$ref": "#/$defs/__schema3"
    },
    "pactVersion": {
      "$ref": "#/$defs/__schema4"
    },
    "goal": {
      "$ref": "#/$defs/__schema5"
    },
    "publicInputs": {
      "$ref": "#/$defs/__schema6"
    },
    "executionTarget": {
      "$ref": "#/$defs/__schema8"
    },
    "minimumPartySize": {
      "$ref": "#/$defs/__schema9"
    },
    "maximumPartySize": {
      "$ref": "#/$defs/__schema10"
    },
    "participants": {
      "$ref": "#/$defs/__schema11"
    },
    "roleSlots": {
      "$ref": "#/$defs/__schema13"
    },
    "requiredOutputs": {
      "$ref": "#/$defs/__schema16"
    },
    "formationDeadline": {
      "$ref": "#/$defs/__schema23"
    },
    "deliveryDeadline": {
      "$ref": "#/$defs/__schema23"
    },
    "verificationCriteria": {
      "$ref": "#/$defs/__schema24"
    },
    "reward": {
      "$ref": "#/$defs/__schema26"
    },
    "failureBehavior": {
      "$ref": "#/$defs/__schema27"
    },
    "createdAt": {
      "$ref": "#/$defs/__schema23"
    }
  },
  "required": [
    "protocol",
    "kind",
    "pactId",
    "missionId",
    "missionVersion",
    "pactVersion",
    "goal",
    "publicInputs",
    "minimumPartySize",
    "maximumPartySize",
    "participants",
    "roleSlots",
    "requiredOutputs",
    "formationDeadline",
    "deliveryDeadline",
    "verificationCriteria",
    "reward",
    "failureBehavior",
    "createdAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "commitment/v1"
    },
    "__schema1": {
      "type": "string",
      "const": "pact"
    },
    "__schema2": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "__schema3": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema4": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema5": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "__schema6": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema7"
      }
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "inputId": {
          "$ref": "#/$defs/__schema2"
        },
        "type": {
          "type": "string",
          "enum": ["url", "inline"]
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "mediaType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      },
      "required": ["inputId", "type", "location", "mediaType", "contentDigest"],
      "additionalProperties": false
    },
    "__schema8": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "guildhall"
            }
          },
          "required": ["kind"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "github"
            },
            "repository": {
              "type": "string",
              "minLength": 3,
              "maxLength": 201,
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})\\/[A-Za-z0-9._-]{1,100}$"
            },
            "baseRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^(?!\\/|.*(?:\\.\\.|@\\{|\\\\|\\s|~|\\^|:|\\?|\\*|\\[))(?!.*\\/$)(?!.*\\.$)[A-Za-z0-9._\\/-]+$"
            },
            "writeMode": {
              "type": "string",
              "enum": ["fork-pr", "branch-pr"]
            },
            "checkPolicy": {
              "type": "string",
              "enum": ["all-success", "not-required"]
            }
          },
          "required": [
            "kind",
            "repository",
            "baseRef",
            "writeMode",
            "checkPolicy"
          ],
          "additionalProperties": false
        }
      ]
    },
    "__schema9": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "__schema10": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "__schema11": {
      "minItems": 2,
      "maxItems": 3,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema12"
      }
    },
    "__schema12": {
      "type": "object",
      "properties": {
        "agentId": {
          "$ref": "#/$defs/__schema2"
        },
        "role": {
          "type": "string",
          "enum": ["requester", "helper"]
        }
      },
      "required": ["agentId", "role"],
      "additionalProperties": false
    },
    "__schema13": {
      "minItems": 1,
      "maxItems": 2,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema14"
      }
    },
    "__schema14": {
      "type": "object",
      "properties": {
        "roleSlotId": {
          "$ref": "#/$defs/__schema2"
        },
        "originalAgentId": {
          "$ref": "#/$defs/__schema2"
        },
        "assignment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "requiredCapabilities": {
          "minItems": 1,
          "maxItems": 16,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema15"
          }
        },
        "dependencyRoleSlotIds": {
          "maxItems": 2,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema2"
          }
        },
        "requiredOutputIds": {
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema2"
          }
        },
        "verificationCriterionIds": {
          "minItems": 1,
          "maxItems": 16,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema2"
          }
        },
        "pointAllocation": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 10000
        }
      },
      "required": [
        "roleSlotId",
        "originalAgentId",
        "assignment",
        "requiredCapabilities",
        "dependencyRoleSlotIds",
        "requiredOutputIds",
        "verificationCriterionIds",
        "pointAllocation"
      ],
      "additionalProperties": false
    },
    "__schema15": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "__schema16": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema17"
      }
    },
    "__schema17": {
      "type": "object",
      "properties": {
        "outputId": {
          "$ref": "#/$defs/__schema2"
        },
        "type": {
          "$ref": "#/$defs/__schema18"
        },
        "description": {
          "$ref": "#/$defs/__schema19"
        },
        "mediaType": {
          "$ref": "#/$defs/__schema20"
        },
        "publicLocation": {
          "$ref": "#/$defs/__schema21"
        },
        "delivery": {
          "$ref": "#/$defs/__schema22"
        }
      },
      "required": ["outputId", "type", "mediaType", "publicLocation"],
      "additionalProperties": false
    },
    "__schema18": {
      "type": "string",
      "enum": [
        "accessibility-findings",
        "remediation-plan",
        "verification-evidence",
        "analysis-report",
        "code-change",
        "deployment-evidence"
      ]
    },
    "__schema19": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "__schema20": {
      "type": "string",
      "const": "application/json"
    },
    "__schema21": {
      "type": "string",
      "const": "mission-artifact"
    },
    "__schema22": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "guildhall-artifact"
            }
          },
          "required": ["kind"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "github-pull-request"
            }
          },
          "required": ["kind"],
          "additionalProperties": false
        }
      ]
    },
    "__schema23": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "__schema24": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema25"
      }
    },
    "__schema25": {
      "type": "object",
      "properties": {
        "criterionId": {
          "$ref": "#/$defs/__schema2"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "required": {
          "type": "boolean",
          "const": true
        },
        "method": {
          "type": "string",
          "enum": ["deterministic", "public-github"]
        }
      },
      "required": ["criterionId", "description", "required", "method"],
      "additionalProperties": false
    },
    "__schema26": {
      "type": "object",
      "properties": {
        "totalPoints": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "replacementRecoveryBonus": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "transferable": {
          "type": "boolean",
          "const": false
        },
        "redeemable": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "totalPoints",
        "replacementRecoveryBonus",
        "transferable",
        "redeemable"
      ],
      "additionalProperties": false
    },
    "__schema27": {
      "type": "object",
      "properties": {
        "negotiationTimeout": {
          "type": "string",
          "const": "reopen-recruitment"
        },
        "participantDefault": {
          "type": "string",
          "const": "recruit-exact-slot-replacement"
        },
        "replacementAuthorized": {
          "type": "boolean",
          "const": true
        },
        "verificationCorrectionLimit": {
          "type": "number",
          "const": 1
        }
      },
      "required": ["participantDefault", "verificationCorrectionLimit"],
      "additionalProperties": false
    }
  },
  "$id": "https://guildhall.dev/protocol/commitment-v1/commitment.schema.json"
}
